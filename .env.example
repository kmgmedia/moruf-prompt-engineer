# Resend Email Service
# Get your API key from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# OpenAI API Key for Chatbot (Backend Only)
# Get your API key from https://platform.openai.com/api-keys
# ⚠️ NEVER commit .env.local to git (it's in .gitignore)
# For production: Add this in Vercel > Project Settings > Environment Variables
OPENAI_SECRET_KEY=your_openai_secret_key_here

# Lead Automation Webhook (recommended)
# Use one stable endpoint from your automation tool (n8n, Activepieces, Pipedream, etc.)
# Example local n8n endpoint: http://localhost:5678/webhook/lead-intake
CRM_WEBHOOK_URL=https://your-workflow-webhook-url-here

# Optional legacy aliases (only if you need backward compatibility)
# N8N_LEAD_WEBHOOK_URL=
# N8N_WEBHOOK_URL=

# Public app URLs used in follow-up messages
# APP_BASE_URL is used as fallback to build /book-call when BOOK_CALL_URL is not set
APP_BASE_URL=https://yourdomain.com
BOOK_CALL_URL=https://yourdomain.com/book-call

# API Server URL (local development only)
# For development: use http://localhost:3001
# For production on Vercel: leave empty (frontend will use same-origin /api)
VITE_API_URL=http://localhost:3001

# Server Port (only used for local server.ts development)
PORT=3001
