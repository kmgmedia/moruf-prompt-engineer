# Resend Email Service
# Get your API key from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# OpenAI API Key for Chatbot (Backend Only)
# Get your API key from https://platform.openai.com/api-keys
# ⚠️ NEVER commit .env.local to git (it's in .gitignore)
# For production: Add this in Vercel > Project Settings > Environment Variables
OPENAI_SECRET_KEY=sk-proj-your-actual-key-here

# API Server URL (local development only)
# For development: use http://localhost:3001
# For production on Vercel: leave empty (will use /api/book-call)
VITE_API_URL=http://localhost:3001

# Server Port (only used for local server.ts development)
PORT=3001
